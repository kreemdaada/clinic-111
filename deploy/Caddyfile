{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	order php_server before file_server
}

{$CADDY_EXTRA_CONFIG}

# Internal HTTP listener for container healthchecks (no TLS, not published).
:8080 {
	bind 127.0.0.1
	root * /app/public

	@blocked {
		path /.env* /.git* /composer.* /vendor/* /storage/* /database/*
	}
	respond @blocked 404

	php_server
	file_server
}

dentalfinance.eu {
	root * /app/public

	encode gzip zstd

	header {
		-X-Powered-By
		-Server
	}

	@blocked {
		path /.env* /.git* /composer.* /vendor/* /storage/* /database/*
	}
	respond @blocked 404

	php_server
	file_server
}

www.dentalfinance.eu {
	redir https://dentalfinance.eu{uri} permanent
}
