# DentalFinance production environment — copy to /opt/dentalfinance/app.env
# Never commit real secrets. chmod 600 app.env

APP_NAME=DentalFinance
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dentalfinance.eu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=dentalfinance
DB_USERNAME=dentalfinance
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Authentication security (ADR-032)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=300
AUTH_REGISTRATION_MAX_ATTEMPTS=3
AUTH_REGISTRATION_DECAY_SECONDS=60

# Resend SMTP (production) — port 587 uses MAIL_SCHEME=smtp (STARTTLS); MAIL_ENCRYPTION is not used in Laravel 13
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=system@dentalfinance.eu
MAIL_FROM_NAME=DentalFinance
MAIL_EHLO_DOMAIN=dentalfinance.eu

# Legal pages — required before go-live (docs/LEGAL_SETUP.md)
LEGAL_OPERATOR_NAME=
LEGAL_BUSINESS_NAME=DentalFinance
LEGAL_ADDRESS_STREET=
LEGAL_ADDRESS_POSTAL_CODE=
LEGAL_ADDRESS_CITY=
LEGAL_ADDRESS_COUNTRY=Deutschland
LEGAL_EMAIL=info@dentalfinance.eu
LEGAL_PRIVACY_EMAIL=datenschutz@dentalfinance.eu
LEGAL_HOSTING_PROVIDER_NAME=IONOS
LEGAL_PRIVACY_LAST_UPDATED=Juni 2026

# Accounting / privacy
ACCOUNTING_PATIENT_REFERENCE_HMAC_KEY=
ACCOUNTING_DELETE_UPLOAD_AFTER_IMPORT=true

# GHCR image base (deploy.sh appends the commit SHA tag)
GHCR_IMAGE=ghcr.io/kreemdaada/clinic-111

# Server-side compose env file path (used by deploy/backup/restore scripts)
# APP_ENV_FILE=/opt/dentalfinance/app.env
