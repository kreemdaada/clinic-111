APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Local development (default)
DB_DATABASE=database/database.sqlite

# --- PostgreSQL (production) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=clinic_accounting
# DB_USERNAME=clinic_user
# DB_PASSWORD=change_me
# DB_SSLMODE=prefer

# Tests always use database/testing.sqlite — see phpunit.xml and .env.testing
# Never point tests at database/database.sqlite (customer dev data).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Authentication security (ADR-032)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=300
AUTH_REGISTRATION_MAX_ATTEMPTS=3
AUTH_REGISTRATION_DECAY_SECONDS=60
# Local dev with MAIL_MAILER=log: auto-verify new clinics and show link on /email/verify
# AUTH_EMAIL_VERIFICATION_AUTO_VERIFY=true
# AUTH_EMAIL_VERIFICATION_SHOW_LINK=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legal pages (Impressum / Datenschutz) — required before production. See docs/LEGAL_SETUP.md
LEGAL_OPERATOR_NAME=
LEGAL_BUSINESS_NAME=DentalFinance
LEGAL_ADDRESS_STREET=
LEGAL_ADDRESS_POSTAL_CODE=
LEGAL_ADDRESS_CITY=
LEGAL_ADDRESS_COUNTRY=Deutschland
LEGAL_EMAIL=
# Public contact link on landing page footer (mailto). Example: contact@your-domain.de
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_COMMERCIAL_REGISTER=
LEGAL_REGISTER_NUMBER=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPERVISORY_AUTHORITY_NAME=
LEGAL_SUPERVISORY_AUTHORITY_URL=
LEGAL_EDITORIAL_RESPONSIBLE_NAME=
LEGAL_HOSTING_PROVIDER_NAME=
LEGAL_PRIVACY_LAST_UPDATED=Juni 2026

# Dedicated secret for patient reference hashing (never use APP_KEY for this).
ACCOUNTING_PATIENT_REFERENCE_HMAC_KEY=
ACCOUNTING_DELETE_UPLOAD_AFTER_IMPORT=true
