APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Isolated from local dev data in database/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

BCRYPT_ROUNDS=4

ACCOUNTING_PATIENT_REFERENCE_HMAC_KEY=test-patient-reference-hmac-key-for-unit-tests-only
ACCOUNTING_DELETE_UPLOAD_AFTER_IMPORT=true
